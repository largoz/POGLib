<Project Sdk="Microsoft.NET.Sdk">
  <!-- POGShops: shop slots for mod items, a mod of its own built on POGLib (ROADMAP 1.6). It reaches POGLib's internals
       (InternalsVisibleTo in POGLib's Plugin.cs) and is released together with it; ShopsMod checks the version. -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>POGLib.Shops</RootNamespace>
    <AssemblyName>POGShops</AssemblyName>
  </PropertyGroup>

  <Import Project="../GameReferences.props" />

  <PropertyGroup>
    <POGConfigDll Condition="'$(POGConfigDll)' == ''">$(GameDir)/Mods/POGConfig.dll</POGConfigDll>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../POGLib.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Optional at runtime: only ShopsPage touches it, behind a NoInlining call. POG Config (Thunderstore: Largo/POG_Config) in
         the profile's Mods/, or -p:POGConfigDll=... -->
    <Reference Include="POGConfig"><HintPath>$(POGConfigDll)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
