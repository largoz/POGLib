<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>POGLib</RootNamespace>
    <AssemblyName>POGLib</AssemblyName>
  </PropertyGroup>

  <Import Project="GameReferences.props" />

  <ItemGroup>
    <!-- tests/ holds separate projects (runtime driver, unit tests); keep their sources out of the library. -->
    <Compile Remove="tests/**" />
    <Compile Remove="samples/**" />
    <Compile Remove="tools/**" />
    <!-- Shops/ is the POGShops mod, a project of its own (Shops/POGShops.csproj) built on this library. -->
    <Compile Remove="Shops/**" />
    <None Remove="Shops/**" />
    <None Remove="tests/**" />
    <None Remove="samples/**" />
  </ItemGroup>

</Project>
