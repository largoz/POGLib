{
  // Rules with mistakes on purpose: each one must produce its own log line (see ../expect.txt).
  "format": 1,
  "mod": "DriverChecks",
  "add": [
    // The host's own file may add to a vanilla slot (a mod's may not in 0.1): the sample's berry in the bread slot.
    { "slot": "vanilla:PitOfGoblin_Lobby/StarterShop/Game.Spawning.ShopLocation Item_Bread", "item": "ShopDemo:GlowBerry", "weight": 10 },
    { "slot": "vanilla:PitOfGoblin_Lobby/StarterShop/Game.Spawning.ShopLocation Item_Bread", "item": "vanilla:Item_Apple", "weight": 1 },
    { "slot": "vanilla:PitOfGoblin_Lobby/StarterShop/Game.Spawning.ShopLocation Item_Bread", "item": "NoSuchItem", "weight": 1 },
    { "slot": "vanilla:PitOfGoblin_Lobby/StarterShop/Game.Spawning.ShopLocation Item_Bread", "item": "FreeThing", "weight": 1 },
    { "slot": "vanilla:PitOfGoblin_Lobby/StarterShop/Game.Spawning.ShopLocation Item_Breadd", "item": "vanilla:Item_Apple", "weight": 1 },
    { "slot": "nosuchslot", "item": "vanilla:Item_Apple", "weight": 1 },
    // A fixed slot made empty: the game's own item has weight 0 at VanillaWeight 0, "nothing" is all that is left.
    { "slot": "vanilla:PitOfGoblin_Lobby/StarterShop/Game.Spawning.ShopLocation Item_Key", "item": "nothing", "weight": 1 },
    // A pool slot (loot table) given a mod item: only the HasNetworkPrefab / LoadNetworkPrefab substitution reaches it.
    { "slot": "vanilla:PitOfGoblin_Lobby/Merchant_Curiosa/Game.Spawning.ShopLocation Item_Dice", "item": "ShopDemo:GlowBerry", "weight": 1 }
  ],
  // A dungeon merchant variant (driver dungeon=1): weight 100 makes the Curiosa preset near certain at the entrance.
  "sellers": [
    { "id": "test_merchant", "preset": "EntranceCave_Shopkeeper_Curiosa", "weight": 100,
      "slots": [ [ { "item": "ShopDemo:GlowBerry", "weight": 1 } ] ] }
  ]
}
