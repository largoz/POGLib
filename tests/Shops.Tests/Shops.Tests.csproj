<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests for the Unity-free parts of the library and of the Shops module (Shops/Model). Run: dotnet test -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Shops/Model/**/*.cs" Link="Model/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- The Unity-free part of the core. -->
    <Compile Include="../../Core/ObjWinding.cs" Link="Core/ObjWinding.cs" />
    <Compile Include="../../Core/Glb.cs" Link="Core/Glb.cs" />
    <Compile Include="../../Cosmetics/Model/**/*.cs" Link="Cosmetics/%(Filename)%(Extension)" />
    <Compile Include="../../Cosmetics/CosmeticDefinition.cs;../../Cosmetics/GoblinLook.cs" Link="Cosmetics/%(Filename)%(Extension)" />
    <None Include="fixtures/*.glb" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
